# CPH Evaluation System - Single Page App (React Router / BrowserRouter)
#
# Base-agnostic: works both at the root of a subdomain (eval.cph-agro.com/)
# and inside a sub-directory (www.cph-agro.com/eval/). All rules are relative
# to the directory holding this file, so no absolute path is hardcoded.
#
# On the shared host the SPA lives under the WordPress root, so the rules of
# this folder must apply BEFORE the parent .htaccess (WordPress), otherwise
# the parent "RewriteRule . /index.php" would swallow the client-side routes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions InheritDownBefore

  # --- API: PostgREST-compatible endpoint (must win over the SPA fallback) ---
  RewriteRule ^rest/v1/(.*)$ rest/v1/api.php [QSA,L]
  RewriteRule ^rest/v1$        rest/v1/api.php [QSA,L]

  # Un asset manquant doit renvoyer 404 (et non index.html)
  RewriteCond %{REQUEST_URI} /assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R404,L]

  # Fichiers et dossiers existants servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # The self-hosted API has no realtime endpoint: answer the
  # WebSocket handshake with a 404 instead of serving index.html.
  RewriteRule ^realtime/ - [R=404,L]

  # Tout le reste -> index.html (routage cote client)
  RewriteRule . index.html [L]
</IfModule>

# The API configuration file holds the database credentials: never serve it.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Cache long sur les assets versionnes (le nom du fichier contient son hash)
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # index.html ne doit jamais etre en cache : il pointe vers les nouveaux assets
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The API always reflects the live database
  <FilesMatch "api\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
