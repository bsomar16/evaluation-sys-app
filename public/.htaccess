# CPH Evaluation System - Single Page App (React Router / BrowserRouter)
#
# Ce dossier est servi sous la racine WordPress : on force les regles de ce
# dossier a s'appliquer AVANT celles du .htaccess parent (WordPress), sinon
# la regle "RewriteRule . /index.php" du parent intercepterait les routes
# cote client.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions InheritDownBefore
  RewriteBase /eval/

  # Uniquement les requetes de ce dossier sont concernees
  RewriteCond %{REQUEST_URI} !^/eval/ [NC]
  RewriteRule ^ - [L]

  # Un asset manquant doit renvoyer 404 (et non index.html)
  RewriteCond %{REQUEST_URI} ^/eval/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R404,L]

  # Fichiers et dossiers existants servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste -> index.html (routage cote client)
  RewriteRule . /eval/index.html [L]
</IfModule>

# Cache long sur les assets versionnes (le nom du fichier contient son hash)
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # index.html ne doit jamais etre en cache : il pointe vers les nouveaux assets
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
