# Copy to .env.local and fill in real values. Never commit .env.local.
# VITE_* vars are embedded into the browser bundle at build time -
# they MUST be the public/anon key only. The service-role key is
# server-side only and must never appear in a VITE_ variable.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- self-hosted PostgREST API (preferred: no Supabase SaaS) ---
# VITE_SUPABASE_URL=https://www.cph-agro.com
# VITE_SUPABASE_PUBLISHABLE_KEY=local-publishable-key
